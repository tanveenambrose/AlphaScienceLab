{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "permission": {
    "bash": "ask",
    "edit": "allow",
    "read": "allow",
    "webfetch": "ask"
  },
  "mcp": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "YOUR_SUPABASE_PERSONAL_ACCESS_TOKEN",
        "SUPABASE_PROJECT_REF": "epqwjnsauwrjlvplkjoa"
      }
    }
  }
}
